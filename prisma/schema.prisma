generator client {
  provider      = "prisma-client-js"
  // native = the machine running generate; rhel-* = the cPanel server (CloudLinux 8 or 9)
  binaryTargets = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Event {
  id                   String       @id @default(cuid())
  title                String
  /// Unique per event (enforced in lib/events/admin.ts uniqueSlug)
  slug                 String?
  excerpt              String?
  description          String?
  venue                String
  address              String?
  city                 String
  country              String       @default("Nigeria")
  eventDate            DateTime
  /// Optional end time; eventDate is the start
  endDate              DateTime?
  eventTime            String?
  /// Ticket sales close at this moment (defaults to the start time when null)
  registrationDeadline DateTime?
  currency             String       @default("NGN")
  /// Legacy single price; events with tiers use TicketTier prices
  ticketPrice          Float?
  isFree               Boolean      @default(false)
  totalTickets         Int?
  posterImage          String?
  isFeatured           Boolean      @default(false)
  status               EventStatus  @default(UPCOMING)
  /// scrypt hash of the volunteer check-in PIN (null = PIN check-in disabled)
  checkInPinHash       String?
  remindersEnabled     Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  tickets              Ticket[]
  tiers                TicketTier[]
  orders               Order[]
  coupons              Coupon[]

  @@index([slug])
}

/// A purchasable ticket type for an event (Regular, VIP, Table for 10…)
model TicketTier {
  id           String    @id @default(cuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  price        Float     @default(0)
  /// null = limited only by the event capacity
  capacity     Int?
  /// Admits this many people per ticket (e.g. a table for 10)
  admits       Int       @default(1)
  maxPerOrder  Int       @default(10)
  saleStartsAt DateTime?
  saleEndsAt   DateTime?
  isVisible    Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tickets      Ticket[]
  orders       Order[]

  @@index([eventId])
}

/// One checkout: groups the tickets bought together and tracks payment.
model Order {
  id         String      @id @default(cuid())
  reference  String      @unique
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tierId     String?
  tier       TicketTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  firstName  String
  lastName   String
  email      String
  phone      String?
  quantity   Int
  unitPrice  Float
  subtotal   Float
  discount   Float       @default(0)
  total      Float
  currency   String      @default("NGN")
  couponId   String?
  coupon     Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  status     OrderStatus @default(PENDING)
  source     OrderSource @default(PUBLIC)
  gateway    String?
  gatewayRef String?
  paidAt     DateTime?
  /// Unpaid orders hold seats until this time, then expire
  expiresAt  DateTime?
  refundedAt DateTime?
  refundRef  String?
  note       String?
  createdBy  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  tickets    Ticket[]

  @@index([eventId, status])
  @@index([email])
}

enum OrderStatus {
  PENDING
  PAID
  FREE
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum OrderSource {
  PUBLIC
  COMPLIMENTARY
  ADMIN
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  /// null = valid for every event
  eventId    String?
  event      Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  percentOff Int?
  amountOff  Float?
  maxUses    Int?
  usedCount  Int       @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  orders     Order[]
}

enum EventStatus {
  DRAFT
  UPCOMING
  PAST
  CANCELLED
}

model Ticket {
  id            String        @id @default(cuid())
  ticketNumber  String        @unique
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  tierId        String?
  tier          TicketTier?   @relation(fields: [tierId], references: [id], onDelete: SetNull)
  /// Tier name at time of purchase (kept if the tier is renamed or deleted)
  tierName      String?
  firstName     String
  lastName      String
  email         String
  phone         String?
  ticketType    TicketType    @default(GENERAL)
  quantity      Int           @default(1)
  totalAmount   Float         @default(0)
  qrCode        String
  qrToken       String        @unique
  isUsed        Boolean       @default(false)
  usedAt        DateTime?
  usedByAdmin   String?
  paymentStatus PaymentStatus @default(PENDING)
  paymentRef    String?
  cancelledAt   DateTime?
  /// Last ticket email: SENT | FAILED | SUPPRESSED (null = never sent)
  emailStatus   String?
  emailedAt     DateTime?
  emailError    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([eventId])
  @@index([orderId])
}

enum TicketType {
  GENERAL
  VIP
  VVIP
  FREE
}

enum PaymentStatus {
  PENDING
  PAID
  FREE
  REFUNDED
}

model Release {
  id             String      @id @default(cuid())
  title          String
  slug           String      @unique
  releaseType    ReleaseType @default(SINGLE)
  description    String?
  coverImage     String?
  spotifyUrl     String?
  appleMusicUrl  String?
  youtubeUrl     String?
  audiomackUrl   String?
  boomplayUrl    String?
  releaseDate    DateTime?
  isFeatured     Boolean     @default(false)
  /// Set for releases imported from Spotify (unique; enforced in lib/sync/spotify.ts)
  spotifyAlbumId String?
  /// Fields an admin edited by hand; sync never overwrites these
  lockedFields   String[]    @default([])
  isHidden       Boolean     @default(false)
  lastSyncedAt   DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([spotifyAlbumId])
}

enum ReleaseType {
  SINGLE
  ALBUM
  EP
}

model GalleryImage {
  id        String          @id @default(cuid())
  imagePath String
  caption   String?
  category  GalleryCategory @default(PERFORMANCE)
  sortOrder Int             @default(0)
  width     Int?
  height    Int?
  createdAt DateTime        @default(now())
}

enum GalleryCategory {
  PERFORMANCE
  PORTRAIT
  EVENTS
  BACKSTAGE
}

model Video {
  id           String    @id @default(cuid())
  title        String
  youtubeId    String
  description  String?
  isFeatured   Boolean   @default(false)
  /// Hidden by an admin; sync never un-hides
  isHidden     Boolean   @default(false)
  sortOrder    Int       @default(0)
  thumbnailUrl String?
  publishedAt  DateTime?
  durationSec  Int?
  /// "youtube" for synced videos, null for manually added ones
  source       String?
  lockedFields String[]  @default([])
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([youtubeId])
}

model ContactMessage {
  id          String      @id @default(cuid())
  name        String
  email       String
  phone       String?
  inquiryType InquiryType @default(GENERAL)
  subject     String
  message     String
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())
}

enum InquiryType {
  BOOKING
  COLLABORATION
  MEDIA
  GENERAL
}

/// Admin-managed configuration (payment keys, email providers, sync credentials).
/// Secret values are AES-256-GCM encrypted; see lib/secret-box.ts.
model SiteSetting {
  key       String   @id
  value     String
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Admin accounts (Admin → Users). Roles and permission keys live in lib/permissions.ts.
model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  name         String?
  /// SUPER_ADMIN | STAFF. Defaults to SUPER_ADMIN so accounts made before roles existed keep full
  /// access; accounts created in Admin → Users always set it.
  role         String    @default("SUPER_ADMIN")
  /// Sections a STAFF account may use. Ignored for SUPER_ADMIN.
  permissions  String[]
  /// Disabled accounts cannot sign in, and their open sessions stop working.
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  accounts     Account[]
  sessions     Session[]
  createdAt    DateTime  @default(now())
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  user         AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Every email sent (or attempted), with provider, delivery status and retry state.
model EmailLog {
  id                String    @id @default(cuid())
  to                String
  subject           String
  /// TICKET | REMINDER | BROADCAST | CONTACT | ADMIN | TEST
  kind              String
  /// QUEUED | SENT | DELIVERED | BOUNCED | COMPLAINED | FAILED | SUPPRESSED
  status            String
  provider          String?
  providerMessageId String?
  error             String?
  attempts          Int       @default(0)
  nextAttemptAt     DateTime?
  /// Rendered message kept so a failed send can be retried
  html              String?
  text              String?
  replyTo           String?
  relatedType       String?
  relatedId         String?
  lastEventAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([providerMessageId])
  @@index([status, nextAttemptAt])
  @@index([relatedType, relatedId])
  @@index([createdAt])
}

/// Addresses that hard-bounced or marked us as spam. Not emailed again until removed.
model EmailSuppression {
  email     String   @id
  reason    String
  provider  String?
  createdAt DateTime @default(now())
}

/// One row per reminder sent, so each attendee gets each reminder once.
model ReminderLog {
  id      String   @id @default(cuid())
  eventId String
  email   String
  /// WEEK | DAY | MORNING
  kind    String
  sentAt  DateTime @default(now())

  @@unique([eventId, email, kind])
}

/// Editable website text and images, one row per section (see lib/content/registry.ts).
/// Missing fields fall back to the defaults in the registry.
model SiteContent {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Mailing list (Admin → Mailing list). One row per address; see lib/mailing/contacts.ts.
model Contact {
  id             String    @id @default(cuid())
  /// Always lower-case
  email          String    @unique
  name           String?
  /// SUBSCRIBED | UNSUBSCRIBED | BOUNCED | COMPLAINED
  status         String    @default("SUBSCRIBED")
  /// IMPORT | SIGNUP | ADMIN
  source         String    @default("ADMIN")
  tags           String[]
  /// Secret in every campaign's unsubscribe link
  token          String    @unique
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

/// An email written in Admin → Campaigns and sent to the mailing list (or one tag of it).
model Campaign {
  id          String             @id @default(cuid())
  subject     String
  preheader   String?
  heading     String?
  body        String
  imageUrl    String?
  buttonLabel String?
  buttonUrl   String?
  /// null = every subscribed contact
  audienceTag String?
  /// DRAFT | SENDING | SENT | CANCELLED
  status      String             @default("DRAFT")
  recipients  Int                @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deliveries  CampaignDelivery[]
}

/// One recipient of a campaign, fixed when the campaign is sent (see lib/mailing/campaigns.ts).
model CampaignDelivery {
  id                String    @id @default(cuid())
  campaignId        String
  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId         String
  email             String
  /// PENDING | SENDING | SENT | DELIVERED | BOUNCED | COMPLAINED | FAILED
  status            String    @default("PENDING")
  provider          String?
  providerMessageId String?
  error             String?
  claimedAt         DateTime?
  sentAt            DateTime?

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([providerMessageId])
}
